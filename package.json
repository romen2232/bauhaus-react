{
  "name": "bauhaus-react",
  "version": "0.3.0",
  "description": "Bauhaus-style React components for Tailwind CSS v4",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "smoke": "node consumer-smoke/check.mjs",
    "smoke:storybook": "node consumer-smoke/check-storybook.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "clsx": "^2.1.1",
    "react-aria-components": "^1.22.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@storybook/test-runner": "^0.26.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "bauhaus",
    "components",
    "ui"
  ]
}
